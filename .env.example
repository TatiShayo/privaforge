# ==============================================================================
# PRIVAFORGE — Enterprise Differential Privacy & Tabular Synthetic Data Engine
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application & Runtime
PRIVAFORGE_ENV=production
PRIVAFORGE_DEBUG=false
PRIVAFORGE_LOG_LEVEL=INFO
PRIVAFORGE_NUM_WORKERS=4
PRIVAFORGE_RANDOM_SEED=42

# Differential Privacy Default Global Budgets
PRIVAFORGE_DEFAULT_EPSILON=1.0
PRIVAFORGE_DEFAULT_DELTA=1e-5
PRIVAFORGE_MAX_BUDGET_EPSILON=100.0
PRIVAFORGE_MAX_BUDGET_DELTA=0.01

# DP Mechanism Parameters
PRIVAFORGE_GAUSSIAN_ANALYTIC=true
PRIVAFORGE_EXPONENTIAL_UTILITY_SENSITIVITY=1.0
PRIVAFORGE_HISTOGRAM_SENSITIVITY=2.0
PRIVAFORGE_COVARIANCE_REGULARIZATION=1e-6

# Privacy Accounting & Composition
PRIVAFORGE_ACCOUNTANT_TYPE=renyi
PRIVAFORGE_RDP_TARGET_DELTA=1e-5
PRIVAFORGE_RDP_MAX_ORDER=256.0
PRIVAFORGE_MOMENTS_MAX_LAMBDA=32

# Synthetic Data Engine Guardrails
PRIVAFORGE_MAX_ROWS=100000
PRIVAFORGE_DEFAULT_SAMPLE_ROWS=1000
PRIVAFORGE_OUTPUT_DIR=./output
PRIVAFORGE_STRICT_REFERENTIAL_INTEGRITY=true
PRIVAFORGE_PSD_PROJECTION_TOLERANCE=1e-6

# Fidelity Evaluation & Quality Thresholds
PRIVAFORGE_MIN_FIDELITY_SCORE=0.75
PRIVAFORGE_MAX_CORRELATION_ERROR=0.35
PRIVAFORGE_MAX_TVD_THRESHOLD=0.25
PRIVAFORGE_MAX_WASSERSTEIN_THRESHOLD=0.30

